{
  "name": "tree-sitter-bend2",
  "version": "0.1.0",
  "description": "Bend2 tree-sitter-parser",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soulthym/tree-sitter-bend2.git"
  },
  "funding": "",
  "license": "MIT",
  "author": {
    "name": "Thybault Alabarbe",
    "email": "thybault.alabarbe@gmail.com",
    "url": "https://github.com/Soulthym/"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "bend2"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.26.9"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "generate": "tree-sitter generate",
    "test": "tree-sitter test",
    "test:bindings": "node --test bindings/node/*_test.js",
    "test:neovim": "tree-sitter build -o build/bend2.so && nvim --headless -u NONE -l scripts/test-neovim.lua",
    "test:upstream": "node scripts/validate-upstream.mjs",
    "test:recovery": "tree-sitter build -o build/bend2.so && nvim --headless -u NONE -l scripts/test-recovery.lua",
    "test:docs": "tree-sitter build -o build/bend2.so && nvim --headless -u NONE -l scripts/test-docs.lua"
  }
}
